# Шаблон локальной конфигурации. Скопируйте в .env: cp .env.example .env
# Секреты допускаются только в .env или в окружении, но не в YAML и не в git.

# --- Процесс ---
APP_ENV=development
APP_BASE_URL=http://localhost:8080
# Необязательный YAML с несекретными настройками; env перекрывает файл.
APP_CONFIG_FILE=
HTTP_ADDR=127.0.0.1:8080
# Метрики только на внутреннем интерфейсе, не публикуются пользовательским router.
METRICS_ADDR=127.0.0.1:9090
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s

# --- PostgreSQL (локальный Compose, срез L02) ---
POSTGRES_USER=english
POSTGRES_PASSWORD=change-me
POSTGRES_DB=english
DATABASE_URL=postgres://english:change-me@localhost:5432/english?sslmode=disable

# --- Продуктовые параметры ---
MEDIA_SIGN_KEY=change-me
TRIAL_DAYS=3

# --- Почта (fake в локальной среде) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@localhost

# --- LLM ---
LLM_PRIMARY_KEY=
LLM_FALLBACK_KEY=
LLM_STRONG_KEY=

# --- Yandex SpeechKit ---
YC_SPEECH_KEY=
YC_FOLDER_ID=

# --- ЮKassa ---
YK_SHOP_ID=
YK_SECRET=

# --- OAuth ---
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
VK_OAUTH_CLIENT_ID=
VK_OAUTH_CLIENT_SECRET=

# --- SmartCaptcha ---
SMARTCAPTCHA_CLIENT_KEY=
SMARTCAPTCHA_SERVER_KEY=

# --- Telegram-алерты ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
